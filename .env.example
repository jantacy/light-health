NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key
LICENSE_ADMIN_SECRET=long-random-secret-for-admin-license-issuance

# Server only. 识图服务（OpenAI 兼容接口）。
# VISION_PROVIDER: deepseek（默认，deepseek-flash）| qwen（阿里百炼 qwen-vl-max-latest）| 其他名称需配 BASE_URL + MODEL
VISION_PROVIDER=deepseek
VISION_API_KEY=
# 可选：覆盖预置的接口地址和模型名
VISION_BASE_URL=
VISION_MODEL=

# 饭点提醒（Web Push）。生成：npx web-push generate-vapid-keys。SUBJECT 填站点 https 地址或 mailto:。
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://meal.example.com
