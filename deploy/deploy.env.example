# 复制为 deploy/deploy.env 并按自己的环境填写（该文件不进 git）。

# 部署目标：SSH 主机名（以 root 登录），空格分隔。deploy.sh 不带参数时发布到这些主机。
DEPLOY_HOSTS="server1"

# 站点域名（nginx server_name）
APP_DOMAIN=meal.example.com

# Next.js 在服务器本机监听的端口
APP_PORT=3100

# nginx 监听参数。普通部署用 "443 ssl"；如果 443 由 nginx stream 按 SNI 分流、再转给 http 块，
# 填转发目标端口，例如 "9000 ssl proxy_protocol"。
NGINX_LISTEN="443 ssl"

# 可选：nginx stream 按 SNI 分流时，把域名加到哪个 upstream（例如 real_web）。留空则不改 nginx.conf。
NGINX_SNI_BACKEND=
